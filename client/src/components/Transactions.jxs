function Transactions() {
  return (
    <div>
      <h2>Transactions</h2>

      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Description</th>
            <th>Amount</th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <td>2026-10-03</td>
            <td>Food</td>
            <td>KES 500</td>
          </tr>
        </tbody>
      </table>
    </div>
  );
}

export default Transactions;
