import React, { useState, useMemo } from 'react';
import { 
  TrendingUp, 
  TrendingDown, 
  DollarSign, 
  Wallet, 
  Plus, 
  Calendar,
  Filter
} from 'lucide-react';

// Mock Initial Data
const INITIAL_TRANSACTIONS = [
  { id: 1, desc: 'Freelance Web Design', amount: 2500, type: 'income', category: 'Design', date: '2026-10-01' },
  { id: 2, desc: 'Monthly Grocery Run', amount: 350, type: 'expense', category: 'Food', date: '2026-10-02' },
  { id: 3, desc: 'Adobe Creative Cloud', amount: 55, type: 'expense', category: 'Software', date: '2026-10-02' },
  { id: 4, desc: 'Stock Dividends', amount: 120, type: 'income', category: 'Investments', date: '2026-10-03' },
];

export default function ExpenseDashboard() {
  const [transactions, setTransactions] = useState(INITIAL_TRANSACTIONS);
  const [filter, setFilter] = useState('all'); // 'all' | 'income' | 'expense'
  const [monthlyBudget, setMonthlyBudget] = useState(1200);

  // Form States for quick-adding entries
  const [desc, setDesc] = useState('');
  const [amount, setAmount] = useState('');
  const [type, setType] = useState('expense');
  const [category, setCategory] = useState('Food');

  // Core Financial Math Calculations
  const metrics = useMemo(() => {
    const income = transactions
      .filter(t => t.type === 'income')
      .reduce((sum, t) => sum + t.amount, 0);

    const expenses = transactions
      .filter(t => t.type === 'expense')
      .reduce((sum, t) => sum + t.amount, 0);

    const balance = income - expenses;
    const budgetUsagePercent = Math.min((expenses / monthlyBudget) * 100, 100);

    return { income, expenses, balance, budgetUsagePercent };
  }, [transactions, monthlyBudget]);

  // Filter Transactions Dynamic Handler
  const filteredTransactions = useMemo(() => {
    if (filter === 'all') return transactions;
    return transactions.filter(t => t.type === filter);
  }, [transactions, filter]);

  // Form Submit Handler
  const handleAddEntry = (e) => {
    e.preventDefault();
    if (!desc || !amount) return;

    const newEntry = {
      id: Date.now(),
      desc,
      amount: parseFloat(amount),
      type,
      category,
      date: new Date().toISOString().split('T')[0]
    };

    setTransactions([newEntry, ...transactions]);
    setDesc('');
    setAmount('');
  };

  return (
    <div className="min-h-screen bg-slate-900 text-slate-100 p-6 font-sans">
      <div className="max-w-7xl mx-auto space-y-6">
        
        {/* Header Section */}
        <header className="flex justify-between items-center border-b border-slate-800 pb-4">
          <div>
            <h1 className="text-3xl font-bold tracking-tight">Financial Dashboard</h1>
            <p className="text-slate-400 text-sm mt-1">Real-time overview of your cash flow and budget targets.</p>
          </div>
          <div className="flex items-center gap-2 bg-slate-800 px-4 py-2 rounded-lg border border-slate-700">
            <Calendar className="w-4 h-4 text-emerald-400" />
            <span className="text-xs font-medium text-slate-300">Oct 2026 Summary</span>
          </div>
        </header>

        {/* 1. Summary Cards (KPI Metrics Row) */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-5">
          {/* Net Balance Card */}
          <div className="bg-slate-800 border border-slate-700 p-5 rounded-xl shadow-lg relative overflow-hidden">
            <div className="flex justify-between items-center">
              <span className="text-sm font-semibold text-slate-400">Net Balance</span>
              <Wallet className="w-5 h-5 text-indigo-400" />
            </div>
            <p className={`text-2xl font-bold mt-2 ${metrics.balance >= 0 ? 'text-emerald-400' : 'text-rose-400'}`}>
              ${metrics.balance.toLocaleString()}
            </p>
          </div>

          {/* Income Card */}
          <div className="bg-slate-800 border border-slate-700 p-5 rounded-xl shadow-lg">
            <div className="flex justify-between items-center">
              <span className="text-sm font-semibold text-slate-400">Total Income</span>
              <TrendingUp className="w-5 h-5 text-emerald-400" />
            </div>
            <p className="text-2xl font-bold mt-2 text-emerald-400">
              +${metrics.income.toLocaleString()}
            </p>
          </div>

          {/* Expenses Card */}
          <div className="bg-slate-800 border border-slate-700 p-5 rounded-xl shadow-lg">
            <div className="flex justify-between items-center">
              <span className="text-sm font-semibold text-slate-400">Total Expenses</span>
              <TrendingDown className="w-5 h-5 text-rose-400" />
            </div>
            <p className="text-2xl font-bold mt-2 text-rose-400">
              -${metrics.expenses.toLocaleString()}
            </p>
          </div>
        </div>

        {/* 2. Budget Alert System Indicator Progress Bar */}
        <div className="bg-slate-800 border border-slate-700 p-5 rounded-xl shadow-md">
          <div className="flex justify-between items-center mb-2">
            <span className="text-sm font-semibold text-slate-300">Monthly Spending Limit Target</span>
            <span className="text-xs text-slate-400">
              ${metrics.expenses} / <strong className="text-slate-200">${monthlyBudget}</strong>
            </span>
          </div>
          <div className="w-full bg-slate-700 h-2.5 rounded-full overflow-hidden">
            <div 
              className={`h-full transition-all duration-500 rounded-full ${
                metrics.budgetUsagePercent > 85 ? 'bg-rose-500' : 'bg-indigo-500'
              }`}
              style={{ width: `${metrics.budgetUsagePercent}%` }}
            />
          </div>
        </div>

        {/* 3. Main Operational Interface (Two Column Layout) */}
        <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          {/* Left Side: Ledger List View (Spans 2 columns) */}
          <div className="lg:col-span-2 bg-slate-800 border border-slate-700 rounded-xl p-5 shadow-lg flex flex-col">
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-700 pb-4 mb-4">
              <h2 className="text-lg font-bold flex items-center gap-2">
                Transaction History Ledger
              </h2>
              {/* Filter Row Tabs Component */}
              <div className="flex bg-slate-900 p-1 rounded-lg border border-slate-700 self-start">
                {['all', 'income', 'expense'].map((type) => (
                  <button
                    key={type}
                    onClick={() => setFilter(type)}
                    className={`px-3 py-1 text-xs font-medium rounded-md capitalize transition-all ${
                      filter === type 
                        ? 'bg-slate-700 text-white shadow' 
                        : 'text-slate-400 hover:text-slate-200'
                    }`}
                  >
                    {type}
                  </button>
                ))}
              </div>
            </div>

            {/* Scrolling List Container */}
            <div className="space-y-2 overflow-y-auto max-h-[380px] pr-2">
              {filteredTransactions.length === 0 ? (
                <div className="text-center py-12 text-slate-500 text-sm">
                  No matching transactions located for this filter view.
                </div>
              ) : (
                filteredTransactions.map((t) => (
                  <div 
                    key={t.id} 
                    className="flex justify-between items-center p-3.5 bg-slate-900/60 hover:bg-slate-900 border border-slate-700/50 rounded-lg transition-all"
                  >
                    <div className="flex items-center gap-3">
                      <div className={`p-2 rounded-lg ${t.type === 'income' ? 'bg-emerald-500/10 text-emerald-400' : 'bg-rose-500/10 text-rose-400'}`}>
                        {t.type === 'income' ? <TrendingUp className="w-4 h-4" /> : <TrendingDown className="w-4 h-4" />}
                      </div>
                      <div>
                        <p className="text-sm font-semibold text-slate-200">{t.desc}</p>
                        <div className="flex items-center gap-2 mt-0.5">
                          <span className="text-[11px] font-medium tracking-wide bg-slate-800 text-slate-400 px-2 py-0.5 rounded border border-slate-700">
                            {t.category}
                          </span>
                          <span className="text-xs text-slate-500">{t.date}</span>
                        </div>
                      </div>
                    </div>
                    <span className={`text-sm font-bold ${t.type === 'income' ? 'text-emerald-400' : 'text-rose-400'}`}>
                      {t.type === 'income' ? '+' : '-'}${t.amount.toFixed(2)}
                    </span>
                  </div>
                ))
              )}
            </div>
          </div>

          {/* Right Side: Quick Action Quick Entry Creation Form Component */}
          <div className="bg-slate-800 border border-slate-700 rounded-xl p-5 shadow-lg">
            <h2 className="text-lg font-bold border-b border-slate-700 pb-4 mb-4">Record New Entry</h2>
            <form onSubmit={handleAddEntry} className="space-y-4">
              
              <div>
                <label className="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5">Type Selection</label>
                <div className="grid grid-cols-2 gap-2 bg-slate-900 p-1 rounded-lg border border-slate-700">
                  <button
                    type="button"
                    onClick={() => setType('expense')}
                    className={`py-1.5 text-xs font-bold rounded-md transition-all ${type === 'expense' ? 'bg-rose-500 text-white' : 'text-slate-400'}`}
                  >
